{
  "name": "enterprise-demo-app",
  "version": "1.0.0",
  "description": "Demo application for multi-cloud deployment verification using Fastify",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
