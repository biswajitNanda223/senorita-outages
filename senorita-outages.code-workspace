{
  "folders": [
    {
      "name": "🎬 SENORITA OUTAGES",
      "path": "."
    },
    {
      "name": "🚀 APP · Fastify Backend",
      "path": "demo-app"
    },
    {
      "name": "🤖 AI · Agent Engine",
      "path": "agent-engine"
    },
    {
      "name": "🏗️ IaC · Terraform",
      "path": "terraform"
    },
    {
      "name": "☸️ OPS · Kubernetes",
      "path": "manifests"
    },
    {
      "name": "🧠 GUIDE · Azure AI Foundry",
      "path": "docs/azure-ai-foundry"
    },
    {
      "name": "🐳 GUIDE · Kubernetes & Docker",
      "path": "docs/kubernetes-and-docker"
    },
    {
      "name": "📚 DOCS · Architecture",
      "path": "docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/node_modules": true,
      "**/.terraform": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.terraform": true,
      "**/*.tfstate": true,
      "**/*.tfstate.backup": true
    },
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.trimAutoWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.bracketPairsHorizontal": "active",
    "editor.guides.highlightActiveIndentation": true,
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontLigatures": true,
    "editor.lineHeight": 24,
    "editor.minimap.enabled": true,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.renderWhitespace": "selection",
    "editor.smoothScrolling": true,
    "editor.stickyScroll.enabled": true,
    "breadcrumbs.enabled": true,
    "explorer.compactFolders": false,
    "workbench.list.smoothScrolling": true,
    "workbench.tree.indent": 18,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.labelFormat": "short",
    "window.title": "🌶️ ${dirty}${activeEditorShort} · Senorita Outages",
    "window.commandCenter": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.smoothScrolling": true,
    "workbench.colorCustomizations": {
      "activityBar.background": "#17132B",
      "activityBar.foreground": "#FFB000",
      "activityBar.inactiveForeground": "#897FA8",
      "activityBarBadge.background": "#FF3D81",
      "activityBarBadge.foreground": "#FFFFFF",
      "activityBar.activeBorder": "#FFB000",
      "sideBar.background": "#12101F",
      "sideBar.foreground": "#EAE5FF",
      "sideBar.border": "#322A50",
      "sideBarTitle.foreground": "#FFB000",
      "sideBarSectionHeader.background": "#1D1833",
      "sideBarSectionHeader.foreground": "#F6D77B",
      "editorGroupHeader.tabsBackground": "#100E1B",
      "editorGroupHeader.tabsBorder": "#322A50",
      "tab.activeBackground": "#211A38",
      "tab.activeForeground": "#FFFFFF",
      "tab.activeBorderTop": "#FF3D81",
      "tab.inactiveBackground": "#151121",
      "tab.inactiveForeground": "#938AAE",
      "titleBar.activeBackground": "#20142E",
      "titleBar.activeForeground": "#FFF4D6",
      "titleBar.inactiveBackground": "#15101F",
      "titleBar.border": "#4A275C",
      "statusBar.background": "#007C78",
      "statusBar.foreground": "#FFFFFF",
      "statusBar.debuggingBackground": "#D14D00",
      "statusBar.noFolderBackground": "#6F2B78",
      "statusBarItem.hoverBackground": "#009B94",
      "panel.background": "#100E1B",
      "panel.border": "#3D315E",
      "terminal.background": "#0D0B16",
      "terminal.foreground": "#E8E2F5",
      "terminalCursor.foreground": "#FFB000",
      "focusBorder": "#FFB000",
      "selection.background": "#FF3D8155",
      "list.activeSelectionBackground": "#4A275C",
      "list.activeSelectionForeground": "#FFFFFF",
      "list.hoverBackground": "#29203F",
      "editorLineNumber.activeForeground": "#FFB000",
      "editorCursor.foreground": "#FF3D81",
      "editorBracketHighlight.foreground1": "#FFB000",
      "editorBracketHighlight.foreground2": "#22C7B8",
      "editorBracketHighlight.foreground3": "#FF62A4",
      "editorBracketHighlight.foreground4": "#8B7CFF",
      "gitDecoration.addedResourceForeground": "#4FD69C",
      "gitDecoration.modifiedResourceForeground": "#FFB000",
      "gitDecoration.deletedResourceForeground": "#FF5C73",
      "gitDecoration.untrackedResourceForeground": "#22C7B8"
    },
    "telemetry.telemetryLevel": "off"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Fastify Backend",
        "skipFiles": ["<node_internals>/**"],
        "program": "${workspaceFolder:🚀 APP · Fastify Backend}/server.js",
        "env": {
          "NODE_ENV": "development",
          "PORT": "8080",
          "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/postgres",
          "REDIS_URL": "redis://localhost:6379"
        }
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug AI Agent Engine",
        "skipFiles": ["<node_internals>/**"],
        "program": "${workspaceFolder:🤖 AI · Agent Engine}/server.js",
        "env": {
          "NODE_ENV": "development",
          "PORT": "9000",
          "ENABLE_TRACING": "true",
          "REDIS_HOST": "localhost",
          "AGENT_WORKSPACE_BUCKET": "my-local-agent-bucket"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Fastify Backend Server",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder:🚀 APP · Fastify Backend}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Start AI Agent Engine",
        "type": "shell",
        "command": "npm start",
        "options": {
          "cwd": "${workspaceFolder:🤖 AI · Agent Engine}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Run Pre-Commit Verification",
        "type": "shell",
        "command": "bash ./cicd/scripts/pre-commit.sh",
        "options": {
          "cwd": "${workspaceFolder:🎬 SENORITA OUTAGES}"
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Terraform Validate",
        "type": "shell",
        "command": "terraform validate",
        "options": {
          "cwd": "${workspaceFolder:🏗️ IaC · Terraform}/azure"
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "hashicorp.terraform",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "gitlab.gitlab-workflow",
      "pkief.material-icon-theme",
      "usernamehw.errorlens",
      "eamodio.gitlens"
    ]
  }
}
